---
// Plugins hub — all plugins, driven by src/data/plugins.json.
// To add a plugin: add one object to the JSON. Fields:
//   name, type, tagline, formats, status ("free" | "beta" | "soon" | "paid"),
//   url (optional — makes the card clickable), image (optional), cta (optional), version (optional)
import plugins from '../data/plugins.json';

const STATUS_LABEL: Record<string, string> = {
  free: 'Free',
  paid: 'Available',
  beta: 'In Beta',
  soon: 'Coming Soon',
};
const isExternal = (u?: string) => !!u && /^https?:\/\//.test(u);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plugins — Yishay Raziel</title>
    <meta name="description" content="Audio plugins by Yishay Raziel — drum synths, saturation, speaker simulation, voiceover and mastering tools." />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href="https://yraziel.com/plugins" />
    <meta property="og:title" content="Plugins — Yishay Raziel" />
    <meta property="og:description" content="Audio plugins by Yishay Raziel." />
    <meta property="og:url" content="https://yraziel.com/plugins" />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a href="/" class="logo-link" aria-label="Home">
          <img src="/logo.png" alt="Yishay Raziel — Music & Sound" class="logo" />
        </a>
        <nav class="top-nav" aria-label="Primary">
          <a href="/" class="nav-link" data-astro-prefetch>Works</a>
          <a href="/plugins" class="nav-link is-active" data-astro-prefetch>Plugins</a>
          <a href="/about" class="nav-link" data-astro-prefetch>About</a>
          <a href="/contact" class="nav-link" data-astro-prefetch>Contact</a>
        </nav>
      </header>

      <main class="plugins">
        <div class="intro">
          <h1>Plugins</h1>
          <p class="tagline">Tools I build for my own studio — shared with yours</p>
        </div>

        <ul class="grid">
          {plugins.map((p: any, i: number) => {
            const Tag = p.url ? 'a' : 'div';
            const ext = isExternal(p.url);
            return (
              <li class="card-wrap" style={`--d:${0.2 + i * 0.06}s`}>
                <Tag
                  class:list={['card', { linked: !!p.url, muted: p.status === 'soon' }]}
                  href={p.url}
                  target={ext ? '_blank' : undefined}
                  rel={ext ? 'noopener' : undefined}
                >
                  <div class="visual">
                    {p.image ? (
                      <img src={p.image} alt={`${p.name} plugin interface`} loading="lazy" />
                    ) : (
                      <span class="wordmark">{p.name}</span>
                    )}
                    <span class={`badge s-${p.status}`}>{STATUS_LABEL[p.status] ?? p.status}</span>
                  </div>
                  <div class="info">
                    <p class="type">{p.type}</p>
                    <h2>
                      {p.name}
                      {p.version && <span class="ver">v{p.version}</span>}
                    </h2>
                    <p class="desc">{p.tagline}</p>
                    <p class="formats">{p.formats}</p>
                    {p.url && <span class="cta">{p.cta ?? 'Download'} <span aria-hidden="true">→</span></span>}
                  </div>
                </Tag>
              </li>
            );
          })}
        </ul>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Yishay Raziel</p>
      </footer>
    </div>

    <style>
      :root {
        --bg: #000000;
        --fg: #ffffff;
        --muted: #8a8a8a;
        --border: #1f1f1f;
        --panel: #0b0b0b;
        --ease: cubic-bezier(0.4, 0, 0.2, 1);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); }
      body {
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Inter', system-ui, sans-serif;
        font-weight: 300;
        letter-spacing: 0.01em;
        -webkit-font-smoothing: antialiased;
        animation: fade-in 0.35s var(--ease) both;
      }
      @keyframes fade-in { from { opacity: 0 } to { opacity: 1 } }
      .page { animation: page-scale-in 0.4s var(--ease) both; }
      @keyframes page-scale-in { from { transform: scale(0.98); } to { transform: scale(1); } }

      /* Header — same structure as the main site, inverted */
      .site-header { padding: 3rem 2rem 1.5rem; text-align: center; }
      .logo-link { display: inline-block; text-decoration: none; }
      .logo {
        width: clamp(180px, 22vw, 260px);
        height: auto;
        display: inline-block;
        filter: invert(1);
        transition: transform 0.6s var(--ease);
      }
      .logo-link:hover .logo { transform: scale(1.02); }
      .top-nav { display: flex; gap: 1.8rem; justify-content: center; margin-top: 1.2rem; flex-wrap: wrap; }
      .nav-link {
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--muted);
        padding: 0.25rem 0.1rem;
        border-bottom: 1px solid transparent;
        transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .nav-link:hover { color: var(--fg); }
      .nav-link.is-active { color: var(--fg); border-bottom-color: var(--fg); }
      @media (max-width: 480px) { .top-nav { gap: 1.1rem; } .nav-link { letter-spacing: 0.12em; } }

      .plugins { max-width: 1240px; margin: 2.5rem auto 6rem; padding: 0 2rem; }
      .intro { text-align: center; margin-bottom: 3rem; }
      .intro h1 {
        margin: 0 0 0.4rem;
        font-size: clamp(1.8rem, 3.5vw, 2.6rem);
        font-weight: 300;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        padding-left: 0.3em;
      }
      .tagline { margin: 0; color: var(--muted); font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; }

      .grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 1.6rem;
      }
      .card-wrap {
        opacity: 0;
        transform: translateY(14px);
        animation: rise 0.7s var(--ease) forwards;
        animation-delay: var(--d);
      }
      @keyframes rise { to { opacity: 1; transform: translateY(0); } }

      .card {
        display: flex;
        flex-direction: column;
        height: 100%;
        color: inherit;
        text-decoration: none;
        border: 1px solid var(--border);
        background: var(--panel);
        transition: border-color 0.35s var(--ease), transform 0.35s var(--ease);
      }
      .card.linked:hover { border-color: #5a5a5a; transform: translateY(-3px); }
      .card.muted .visual, .card.muted .info h2 { opacity: 0.55; }

      .visual {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 30%, #161616 0%, #070707 70%);
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid var(--border);
      }
      .visual img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 0.6rem;
        display: block;
        transition: transform 1.2s var(--ease);
      }
      .card.linked:hover .visual img { transform: scale(1.04); }
      .wordmark {
        font-size: clamp(1.4rem, 2.6vw, 1.9rem);
        font-weight: 200;
        letter-spacing: 0.32em;
        padding-left: 0.32em;
        text-transform: uppercase;
        text-align: center;
      }

      .badge {
        position: absolute;
        top: 0.8rem;
        left: 0.8rem;
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.35rem 0.6rem;
        border: 1px solid currentColor;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
      }
      .s-free, .s-paid { color: #fff; }
      .s-beta { color: #c9c9c9; }
      .s-soon { color: #8a8a8a; }

      .info { padding: 1.2rem 1.3rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
      .type { margin: 0 0 0.35rem; color: var(--muted); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
      .info h2 {
        margin: 0 0 0.6rem;
        font-size: 1.35rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .ver { font-size: 0.7rem; color: var(--muted); letter-spacing: 0.08em; }
      .desc { margin: 0 0 1rem; color: #cfcfcf; font-size: 0.92rem; line-height: 1.6; }
      .formats { margin: auto 0 0; color: var(--muted); font-size: 0.75rem; letter-spacing: 0.08em; }
      .cta {
        margin-top: 1rem;
        align-self: flex-start;
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--fg);
        padding-bottom: 2px;
      }
      .card.linked:hover .cta span { display: inline-block; transform: translateX(3px); transition: transform 0.3s var(--ease); }

      @media (max-width: 600px) {
        .plugins { padding: 0 1.1rem; }
        .grid { gap: 1.1rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .card-wrap { animation: none; opacity: 1; transform: none; }
      }

      footer {
        text-align: center;
        padding: 2rem;
        color: var(--muted);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </body>
</html>
